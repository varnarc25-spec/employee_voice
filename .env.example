# Copy to .env for Docker Compose. Replace every placeholder before use.
# Do not commit .env.

POSTGRES_USER=employee_voice
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=employee_voice

# Local development only. Production startup rejects keys that contain this marker.
JWT_SIGNING_KEY=dev-only-not-for-production-replace-with-32-plus-bytes

# Optional. When set in Development, that exact synthetic address receives staff roles other than administrator.
# Leave empty unless you are seeding a local reviewer. Super admin is only business@varnarc.com.
SEED_DEMO_ADMIN_EMAIL=

# Local development uses the same bootstrap password as the Varnarc admin when this is empty.
# Production startup rejects a value that contains "change-me".
ADMIN_BOOTSTRAP_PASSWORD=

# Same Auth0 tenant as the Varnarc admin. Leave blank until the values are set outside git.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_ISSUER_BASE_URL=
AUTH0_CONNECTION=Username-Password-Authentication
ADMIN_BASE_URL=http://localhost:5174

# SMTP is required when ASPNETCORE_ENVIRONMENT=Production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Phone codes. Leave empty in local Development, which uses the local code provider.
# Production requires PhoneOtp:Provider=Msg91.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Google Sign-In web client id. The Android app also needs this as GOOGLE_SERVER_CLIENT_ID.
GOOGLE_CLIENT_ID=

# LinkedIn OAuth. The secret stays on the API. Register the redirect URL in the LinkedIn app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.example.com/auth/linkedin/callback

# Optional Firebase Cloud Messaging. Leave empty to keep push delivery off.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
