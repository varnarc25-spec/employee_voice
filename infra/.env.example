# Copy to infra/.env on the VPS. Do not commit infra/.env.
POSTGRES_USER=employee_voice
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=employee_voice
JWT_SIGNING_KEY=replace-with-32-or-more-random-characters
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=https://evadmin.varnarc.com,http://evadmin.varnarc.com
PUBLIC_BASE_URL=https://evadmin.varnarc.com
ADMIN_BASE_URL=https://evadmin.varnarc.com
# Leave empty so the admin container sends /api to the API container.
VITE_API_BASE_URL=
